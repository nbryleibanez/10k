{
  "name": "tenk-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@8.15.4",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:ui": "playwright test",
    "format": "prettier --write .",
    "generate:openapi": "cd ../backend && cargo run -p tenk-api-spec > ../openapi.json",
    "generate:api-types": "pnpm generate:openapi && openapi-typescript ../openapi.json -o src/lib/api/generated.ts",
    "test:contract": "pnpm generate:api-types && git diff --exit-code src/lib/api/generated.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.43.0",
    "@sveltejs/adapter-auto": "^3.2.0",
    "@sveltejs/adapter-static": "^3.0.2",
    "@sveltejs/kit": "^2.5.0",
    "@sveltejs/vite-plugin-svelte": "^3.1.0",
    "@tsconfig/svelte": "^5.0.2",
    "@types/node": "^20.11.30",
    "autoprefixer": "^10.4.17",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-svelte3": "^4.0.0",
    "postcss": "^8.4.35",
    "prettier": "^3.2.5",
    "prettier-plugin-svelte": "^3.2.1",
    "svelte": "^4.2.12",
    "svelte-check": "^3.6.4",
    "tailwindcss": "^3.4.1",
    "tslib": "^2.6.2",
    "typescript": "^5.4.3",
    "vite": "^5.1.4",
    "vitest": "^1.4.0",
    "openapi-typescript": "^6.4.0"
  },
  "dependencies": {
    "@aws-amplify/auth": "^6.1.0",
    "@aws-amplify/core": "^6.1.0",
    "@felte/validator-zod": "^1.3.4",
    "@radix-ui/colors": "^3.0.0",
    "@tanstack/svelte-query": "^5.29.0",
    "@tanstack/query-core": "^5.29.0",
    "@sentry/sveltekit": "^8.1.0",
    "chart.js": "^4.4.1",
    "felte": "^1.4.4",
    "svelte-sonner": "^0.3.9",
    "web-vitals": "^4.0.1",
    "zod": "^3.22.4"
  }
}
